---
// src/pages/resources/[...slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('resources', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.date.toISOString().slice(0, 10);
---
<BaseLayout title={post.data.title}>
  <article class="article">
    <header class="article-head">
      <div class="article-meta">
        <span class="tag tag-eco">{post.data.category}</span>
        <time datetime={dateStr}>{dateStr}</time>
      </div>
      <h1 class="article-title">{post.data.title}</h1>
    </header>
    <div class="prose"><Content /></div>
    {post.data.attachments && post.data.attachments.length > 0 && (
      <section class="attach">
        <h2>첨부파일</h2>
        <ul>{post.data.attachments.map((a) => <li><a href={withBase(a.url)}>{a.name}</a></li>)}</ul>
      </section>
    )}
    {post.data.externalLink && (
      <p class="article-ext"><a class="btn btn-outline" href={post.data.externalLink} target="_blank" rel="noopener">링크 열기 →</a></p>
    )}
    <a class="back-link" href={withBase('/resources')}>← 목록으로 돌아가기</a>
  </article>
</BaseLayout>
