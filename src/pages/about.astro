---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../consts';

const teams = [
  { name: '환경·화학공학 연구팀', desc: '생분해성·재활용 대체소재 개발과 플라스틱 저감 공정을 연구합니다.', meta: '교수 11 · 학생 19' },
  { name: '빅데이터·AI 분석 연구팀', desc: '생성형 AI로 대체재를 예측하고 소비자 행동 데이터를 분석합니다.', meta: '교수 1 · 학생 3' },
  { name: '자원순환 연구팀', desc: '자원순환 체계와 기업 ESG 전략 최적화를 연구합니다.', meta: '교수 5 · 학생 5' },
];
---
<BaseLayout title="About" wide={true}>
  <PageHeader
    eyebrow="About"
    title="사업단 소개"
    description={SITE.tagline + ' (중앙대학교)'}
  />

  <section class="section container about">
    <div class="about-intro reveal">
      <p class="eyebrow">Vision</p>
      <h2 class="section-title">지속가능한 미래를 위한<br />순환경제 융합 인재양성</h2>
      <p class="about-lead">
        중앙대학교 포스트 플라스틱 허브는 탈플라스틱·순환경제 분야의 융합 인재를
        양성하고, 생분해성 소재·자원순환·ESG 전략 연구를 통해 지속가능한 미래에
        기여합니다.
      </p>
    </div>

    <div class="teams reveal">
      <p class="eyebrow">Research Teams</p>
      <h3 class="teams-title">참여 연구팀</h3>
      <div class="teams-grid">
        {teams.map((t) => (
          <article class="team-card">
            <h4>{t.name}</h4>
            <p>{t.desc}</p>
            <span class="team-meta">{t.meta}</span>
          </article>
        ))}
      </div>
    </div>

    <p class="note">※ 위 내용은 예시이며, 담당자가 실제 사업단 소개·교수진·연구팀 정보로 교체합니다.</p>
  </section>
</BaseLayout>

<style>
  .about { padding-top: 80px; padding-bottom: 96px; }
  .about-intro { max-width: 720px; margin-bottom: 72px; }
  .about-lead { margin-top: 22px; color: var(--ink-soft); font-size: 1.15rem; line-height: 1.85; }
  .teams-title { font-size: 1.7rem; margin-top: 14px; margin-bottom: 30px; color: var(--ink); }
  .teams-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .team-card {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 30px 28px; box-shadow: var(--shadow-sm);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .team-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
  .team-card h4 { font-size: 1.15rem; color: var(--ink); margin-bottom: 12px; }
  .team-card p { color: var(--ink-soft); line-height: 1.7; margin: 0 0 18px; }
  .team-meta { font-family: var(--font-mono); font-size: 0.78rem; color: var(--eco-600); font-weight: 600; }
  .note { color: var(--muted); font-size: 0.9rem; margin-top: 48px; }
  @media (max-width: 820px) { .teams-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
