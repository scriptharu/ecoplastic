---
// src/pages/courses.astro — 학기별 개설 교과목 (클릭 시 해당 학교 e-class로 이동)
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { OPEN_COURSES, ECLASS, COURSE_LOG_ENDPOINT } from '../consts';
const UNIVS = Object.keys(ECLASS) as (keyof typeof ECLASS)[];
---
<BaseLayout title="개설 교과목" wide={true}>
  <PageHeader
    eyebrow="Courses"
    title="개설 교과목"
    description="학기별 개설 교과목 목록입니다. 교과목을 클릭하면 개설 학교의 e-class로 이동합니다."
  />

  <!-- 접속 기록용 입력 — 제출하면 목록이 나타난다 -->
  <section class="section container" data-gate>
    <form class="gate" data-gate-form data-endpoint={COURSE_LOG_ENDPOINT}>
      <h2 class="gate-title">이용자 정보 입력</h2>
      <p class="gate-lead">아래 정보를 입력하시면 학기별 개설 교과목 목록을 확인하실 수 있습니다.</p>

      <fieldset class="field">
        <legend>학교</legend>
        <div class="univ-opts">
          {UNIVS.map((u, i) => (
            <label class="univ-opt">
              <input type="radio" name="univ" value={u} required checked={i === 0} />
              <span>{u}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="field-row">
        <label class="field">
          <span class="field-label">학번</span>
          <input type="text" name="studentId" required maxlength="20" autocomplete="off" inputmode="numeric" placeholder="예: 20261234" />
        </label>
        <label class="field">
          <span class="field-label">이름</span>
          <input type="text" name="name" required maxlength="30" autocomplete="name" placeholder="예: 홍길동" />
        </label>
      </div>

      <p class="gate-error" data-gate-error hidden role="alert"></p>

      <div class="gate-actions">
        <button type="submit" class="btn btn-primary" data-gate-submit>교과목 목록 보기</button>
        <button type="button" class="gate-skip" data-gate-skip hidden>건너뛰고 목록 보기</button>
      </div>
    </form>
  </section>

  <section class="section container" data-courses hidden>
    {OPEN_COURSES.map((s) => (
      <div class="sem reveal">
        <div class="sem-head">
          <h2 class="sem-title">{s.semester}</h2>
          <span class="sem-count">{s.courses.length}과목</span>
        </div>
        <div class="table-wrap">
          <table class="course-table">
            <thead>
              <tr><th scope="col">교과목</th><th scope="col">교수</th><th scope="col">개설학교</th></tr>
            </thead>
            <tbody>
              {s.courses.map((c) => (
                <tr>
                  <td data-label="교과목">
                    <a
                      class="c-link"
                      href={ECLASS[c.univ]}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${c.nameKo} — ${c.univ} e-class 바로가기 (새 창)`}
                    >
                      <span class="c-ko">{c.nameKo}</span>
                      <span class="c-en">{c.nameEn}</span>
                    </a>
                  </td>
                  <td data-label="교수" class="c-prof">{c.professor}</td>
                  <td data-label="개설학교" class="c-univ">
                    <span class="univ-chip">{c.univ}</span>
                    <svg class="ext" width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}

    <p class="note reveal">
      수강신청 일정 및 세부사항은 각 대학의 학사일정을 참고하시기 바랍니다.
      개설 교과목은 학사 사정에 따라 변경될 수 있습니다.
    </p>
  </section>
</BaseLayout>

<style>
  /* ---------- 이용자 정보 입력 ---------- */
  .gate {
    max-width: 560px; margin: 0 auto; background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 36px 34px 34px; box-shadow: var(--shadow-sm);
    border-top: 3px solid var(--eco-500);
  }
  .gate-title { font-size: 1.3rem; margin: 0; color: var(--ink); }
  .gate-lead { margin: 10px 0 26px; color: var(--ink-soft); line-height: 1.7; font-size: 0.96rem; }

  .field { display: block; border: 0; padding: 0; margin: 0 0 18px; min-width: 0; }
  .field legend, .field-label {
    display: block; padding: 0; margin-bottom: 9px;
    font-size: 0.86rem; font-weight: 700; color: var(--ink);
  }
  .field input[type="text"] {
    width: 100%; padding: 12px 14px; font: inherit; font-size: 0.96rem;
    color: var(--ink); background: var(--surface-2);
    border: 1.5px solid var(--line); border-radius: 12px;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .field input[type="text"]:focus {
    outline: none; border-color: var(--eco-500); background: var(--surface);
  }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  .univ-opts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .univ-opt {
    display: flex; align-items: center; gap: 9px; cursor: pointer;
    padding: 12px 14px; border: 1.5px solid var(--line); border-radius: 12px;
    background: var(--surface-2); font-size: 0.92rem; font-weight: 600; color: var(--ink-soft);
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .univ-opt input { accent-color: var(--eco-600); margin: 0; flex: none; }
  .univ-opt:has(input:checked) { border-color: var(--eco-500); color: var(--ink); background: var(--surface); }
  .univ-opt:has(input:focus-visible) { outline: 2px solid var(--eco-500); outline-offset: 2px; }

  .gate-error {
    margin: 0 0 16px; padding: 11px 14px; border-radius: 10px;
    background: rgba(203, 60, 60, 0.08); border: 1px solid rgba(203, 60, 60, 0.28);
    color: #a12f2f; font-size: 0.89rem; line-height: 1.6;
  }
  .gate-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 22px; }
  .gate-actions .btn[disabled] { opacity: 0.6; cursor: progress; transform: none; }
  .gate-skip {
    background: none; border: 0; padding: 0; cursor: pointer; font: inherit;
    font-size: 0.88rem; font-weight: 600; color: var(--muted); text-decoration: underline;
  }
  .gate-skip:hover { color: var(--ink-soft); }

  @media (max-width: 520px) {
    .gate { padding: 28px 22px 26px; }
    .field-row, .univ-opts { grid-template-columns: 1fr; }
  }

  /* ---------- 교과목 목록 ---------- */
  .sem { margin-bottom: 56px; }
  .sem:last-of-type { margin-bottom: 0; }
  .sem-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 18px; }
  .sem-title {
    font-size: 1.5rem; margin: 0; color: var(--ink); letter-spacing: -0.02em;
    font-family: var(--font-mono); font-weight: 700;
  }
  .sem-count {
    font-size: 0.8rem; font-weight: 700; color: var(--eco-700);
    background: rgba(15, 157, 99, 0.12); padding: 3px 10px; border-radius: 20px;
  }

  .table-wrap { overflow-x: auto; }
  .course-table {
    width: 100%; min-width: 640px; border-collapse: collapse;
    background: var(--surface); border: 1px solid var(--line);
  }
  .course-table th, .course-table td {
    padding: 14px 18px; text-align: left; font-size: 0.95rem;
    border-bottom: 1px solid var(--line); border-right: 1px solid var(--line);
  }
  .course-table th:last-child, .course-table td:last-child { border-right: 0; }
  .course-table thead th { background: var(--cau-700); color: #fff; font-weight: 700; }
  .course-table thead th:nth-child(2), .course-table thead th:nth-child(3) { width: 1%; white-space: nowrap; }
  .course-table tbody tr:last-child td { border-bottom: 0; }
  .course-table tbody tr { transition: background 0.18s var(--ease); }
  .course-table tbody tr:hover { background: var(--surface-2); }

  /* 행 전체를 클릭 영역으로 — 첫 셀의 링크를 오버레이로 확장 */
  .course-table tbody tr { position: relative; }
  .c-link { display: block; color: inherit; }
  .c-link::after { content: ""; position: absolute; inset: 0; }
  .c-link:focus-visible { outline: 2px solid var(--eco-500); outline-offset: 2px; border-radius: 4px; }
  .c-ko { display: block; font-weight: 700; color: var(--ink); line-height: 1.45; }
  .c-en { display: block; margin-top: 3px; font-size: 0.82rem; color: var(--muted); line-height: 1.5; }
  .course-table tbody tr:hover .c-ko { color: var(--cau-700); }

  .c-prof { color: var(--ink-soft); white-space: nowrap; }
  .c-univ { white-space: nowrap; }
  .univ-chip {
    font-size: 0.78rem; font-weight: 700; color: var(--cau-700);
    background: rgba(21, 84, 192, 0.08); padding: 4px 10px; border-radius: 20px;
  }
  .ext { margin-left: 8px; color: var(--muted); vertical-align: -1px; transition: color 0.18s var(--ease); }
  .course-table tbody tr:hover .ext { color: var(--eco-600); }

  .note {
    margin: 40px 0 0; color: var(--muted); font-size: 0.9rem; line-height: 1.75;
    padding-left: 16px; border-left: 3px solid var(--line);
  }

  /* 모바일: 표를 카드형으로 전환 (가로 스크롤 제거) */
  @media (max-width: 640px) {
    .table-wrap { overflow-x: visible; }
    .course-table { min-width: 0; border: 0; background: transparent; }
    .course-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .course-table tbody, .course-table tr, .course-table td { display: block; }
    .course-table tr {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 12px;
    }
    .course-table tbody tr:last-child { margin-bottom: 0; }
    .course-table td { border: 0; border-top: 1px solid var(--line); padding: 11px 16px; }
    .course-table tr td:first-child { border-top: 0; padding: 14px 16px; }
    .course-table td:not(:first-child) {
      display: flex; justify-content: flex-end; align-items: center; gap: 8px;
    }
    /* 라벨은 왼쪽 끝, 값(칩+아이콘)은 오른쪽에 붙여서 함께 */
    .course-table td:not(:first-child)::before {
      content: attr(data-label); flex: none; margin-right: auto;
      font-weight: 700; color: var(--ink); font-size: 0.86rem;
    }
    .ext { margin-left: 0; }
  }
</style>

<script>
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  const gate = document.querySelector<HTMLElement>('[data-gate]');
  const form = document.querySelector<HTMLFormElement>('[data-gate-form]');
  const courses = document.querySelector<HTMLElement>('[data-courses]');
  const errorBox = document.querySelector<HTMLElement>('[data-gate-error]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-gate-submit]');
  const skipBtn = document.querySelector<HTMLButtonElement>('[data-gate-skip]');

  const showCourses = () => {
    if (!gate || !courses) return;
    gate.hidden = true;
    courses.hidden = false;
    // 숨겨진 동안에는 교차 관찰이 일어나지 않으므로, 노출 직후 한 번 더 밀어준다.
    requestAnimationFrame(() => {
      courses.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const showError = (msg: string) => {
    if (!errorBox) return;
    errorBox.textContent = msg;
    errorBox.hidden = false;
    if (skipBtn) skipBtn.hidden = false;
  };

  /**
   * Apps Script 웹앱은 CORS preflight를 처리하지 못하므로 text/plain으로 보내
   * "simple request"가 되게 한다. 응답을 읽지 못해도 기록은 남으므로,
   * CORS로 읽기가 막히면 no-cors로 한 번 더 시도한다.
   */
  const postLog = async (endpoint: string, payload: unknown) => {
    const body = JSON.stringify(payload);
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body,
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
    } catch {
      await fetch(endpoint, { method: 'POST', mode: 'no-cors', body });
    }
  };

  skipBtn?.addEventListener('click', showCourses);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const payload = {
      univ: String(data.get('univ') ?? ''),
      studentId: String(data.get('studentId') ?? '').trim(),
      name: String(data.get('name') ?? '').trim(),
    };
    if (!payload.univ || !payload.studentId || !payload.name) return;

    const endpoint = form.dataset.endpoint?.trim();
    // 엔드포인트가 아직 설정되지 않았으면 기록 없이 통과시킨다.
    if (!endpoint) { showCourses(); return; }

    if (errorBox) errorBox.hidden = true;
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = '기록 중…'; }

    try {
      await postLog(endpoint, payload);
      showCourses();
    } catch {
      showError('기록 저장에 실패했습니다. 네트워크 상태를 확인한 뒤 다시 시도해 주세요.');
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = '교과목 목록 보기'; }
    }
  });
</script>
