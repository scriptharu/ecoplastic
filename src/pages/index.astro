---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, STATS, STRATEGIES, TRACKS } from '../consts';
import { withBase } from '../lib/url';
---
<BaseLayout title={SITE.title} wide={true}>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow hero-eyebrow">CAU · KIT — Plastic-Free Tech Hub</p>
      <h1 class="hero-title">
        플라스틱 이후를 설계하는<br />
        <span class="hl">탈플라스틱 융합기술</span> 허브
      </h1>
      <p class="hero-sub">
        중앙대학교와 국립금오공과대학교가 수도권–경북권 이중거점으로 손잡고,
        소재·공정·정책·스마트기술을 아우르는 탈플라스틱 전주기 전문인력을 양성합니다.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={withBase('/about')}>사업단 소개 <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={withBase('/notices')}>공지사항 보기</a>
      </div>
    </div>
    <a class="scroll-cue" href="#mission" aria-label="아래로 스크롤">
      <span></span>
    </a>
  </section>

  <!-- ================= MISSION ================= -->
  <section id="mission" class="section mission">
    <div class="container mission-grid reveal">
      <div class="mission-head">
        <p class="eyebrow">Our Mission</p>
        <h2 class="section-title">탈플라스틱 전환을<br />이끄는 이중거점 융합교육</h2>
      </div>
      <div class="mission-body">
        <p>
          수도권 거점 <strong>중앙대학교</strong>는 첨단 연구 인프라를 기반으로 순환형
          플라스틱 원천기술과 특수 제조기술 교육을, 경북권 거점 <strong>국립금오공과대학교</strong>는
          구미·포항 산업단지와 연계한 현장 실증·기업 연계 교육을 담당합니다.
        </p>
        <p>
          플라스틱 저감부터 대체소재 개발, 재활용·자원화, 위해성 평가까지 전주기를
          아우르는 5개 트랙을 운영하여, 석·박사급 전문인력 140명을 양성하고
          지속가능한 순환경제 생태계를 구축합니다.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <section class="stats-band">
    <div class="container stats-grid reveal">
      {STATS.map((s) => (
        <div class="stat">
          <div class="stat-num"><span class="count" data-count={s.value}>0</span>{s.suffix ?? ''}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= TRACKS ================= -->
  <section class="section tracks">
    <div class="container">
      <div class="tracks-head reveal">
        <p class="eyebrow">Curriculum</p>
        <h2 class="section-title">5개 융합기술 트랙</h2>
        <p class="section-lead">탈플라스틱 전주기를 다섯 갈래로 나누어 소재부터 정책·스마트기술까지 전문 인재를 양성합니다.</p>
      </div>
      <div class="tracks-grid">
        {TRACKS.map((t, i) => (
          <article class="track-card reveal" style={`transition-delay:${i * 70}ms`}>
            <div class="track-top">
              <span class="track-no">TRACK {t.no}</span>
              <span class="track-univ">{t.univ}</span>
            </div>
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
          </article>
        ))}
      </div>
      <div class="tracks-more reveal">
        <a class="btn btn-ghost" href={withBase('/program')}>교육과정 자세히 보기 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ================= STRATEGIES ================= -->
  <section class="section strategy">
    <div class="container">
      <div class="strategy-head reveal">
        <p class="eyebrow">Strategy</p>
        <h2 class="section-title">4대 사업 추진 방향</h2>
        <p class="section-lead">교육·산학·성과확산·글로벌 협력의 네 축으로 탈플라스틱 인재양성을 추진합니다.</p>
      </div>
      <div class="strategy-grid">
        {STRATEGIES.map((s, i) => (
          <article class="strat-card reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="strat-no">STRATEGY {s.no}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span class="strat-line" aria-hidden="true"></span>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .hero { position: relative; overflow: hidden; color: #fff; padding: 150px 0 130px; }
  .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(720px 460px at 78% 12%, var(--eco-glow), transparent 60%),
      radial-gradient(900px 600px at 8% 90%, rgba(21, 84, 192, 0.6), transparent 60%),
      linear-gradient(160deg, var(--cau-800) 0%, var(--cau-900) 60%, #050f26 100%);
  }
  .hero-bg::after {
    content: ""; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.10) 1px, transparent 1.4px);
    background-size: 26px 26px;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 78%);
    mask-image: linear-gradient(180deg, #000 0%, transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; }
  .hero-eyebrow { color: var(--eco-400); animation: rise 0.7s var(--ease) both; }
  .hero-eyebrow::before { background: var(--eco-400); }
  .hero-title {
    font-size: clamp(2.2rem, 5.4vw, 4rem); font-weight: 800; line-height: 1.12;
    margin: 22px 0 0; letter-spacing: -0.04em; max-width: 15ch;
    animation: rise 0.7s var(--ease) 0.08s both;
  }
  .hero-title .hl {
    background: linear-gradient(100deg, var(--eco-400), #7ef0c0);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-sub {
    margin: 24px 0 0; max-width: 46ch; font-size: 1.12rem;
    color: rgba(255, 255, 255, 0.78); line-height: 1.7;
    animation: rise 0.7s var(--ease) 0.16s both;
  }
  .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 36px; animation: rise 0.7s var(--ease) 0.24s both; }
  @keyframes rise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }

  .scroll-cue { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); z-index: 1; }
  .scroll-cue span {
    display: block; width: 26px; height: 42px; border: 2px solid rgba(255, 255, 255, 0.4);
    border-radius: 14px; position: relative;
  }
  .scroll-cue span::after {
    content: ""; position: absolute; left: 50%; top: 8px; width: 4px; height: 8px;
    background: var(--eco-400); border-radius: 2px; transform: translateX(-50%);
    animation: cue 1.6s infinite;
  }
  @keyframes cue { 0% { opacity: 0; transform: translate(-50%, 0); } 40% { opacity: 1; } 80% { opacity: 0; transform: translate(-50%, 14px); } }

  /* ---------- MISSION ---------- */
  .mission-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items: start; }
  .mission-head { position: relative; padding-left: 22px; }
  .mission-head::before { content: ""; position: absolute; left: 0; top: 6px; bottom: 6px; width: 3px; background: var(--eco-500); border-radius: 3px; }
  .mission-body p { color: var(--ink-soft); font-size: 1.1rem; line-height: 1.85; margin: 0 0 18px; }

  /* ---------- STATS ---------- */
  .stats-band {
    background:
      radial-gradient(700px 300px at 90% 0%, rgba(23, 185, 120, 0.10), transparent 60%),
      var(--surface-2);
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    padding: 60px 0;
  }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; text-align: center; }
  .stat-num { font-family: var(--font-mono); font-weight: 600; font-size: clamp(2.2rem, 4vw, 3rem); color: var(--cau-700); letter-spacing: -0.02em; }
  .stat-label { margin-top: 6px; color: var(--muted); font-weight: 600; font-size: 0.95rem; }

  /* ---------- TRACKS ---------- */
  .tracks { background: var(--surface-2); border-bottom: 1px solid var(--line); }
  .tracks-head { text-align: center; max-width: 680px; margin: 0 auto 52px; }
  .tracks-head .eyebrow { justify-content: center; }
  .tracks-head .section-lead { margin-left: auto; margin-right: auto; }
  .tracks-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .track-card {
    position: relative; background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 32px 28px 30px; box-shadow: var(--shadow-sm);
    border-top: 3px solid var(--eco-500);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .track-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }
  .track-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .track-no { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; color: var(--eco-600); }
  .track-univ { font-size: 0.72rem; font-weight: 700; color: var(--cau-700); background: rgba(21, 84, 192, 0.08); padding: 3px 9px; border-radius: 20px; white-space: nowrap; }
  .track-card h3 { font-size: 1.25rem; margin: 14px 0 12px; color: var(--ink); }
  .track-card p { color: var(--ink-soft); line-height: 1.72; margin: 0; font-size: 0.97rem; }
  .tracks-more { text-align: center; margin-top: 40px; }

  /* ---------- STRATEGY ---------- */
  .strategy-head { text-align: center; max-width: 640px; margin: 0 auto 52px; }
  .strategy-head .eyebrow { justify-content: center; }
  .strategy-head .section-lead { margin-left: auto; margin-right: auto; }
  .strategy-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .strat-card {
    position: relative; overflow: hidden; background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: 38px 32px 40px; box-shadow: var(--shadow-sm);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .strat-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: rgba(23, 185, 120, 0.4); }
  .strat-no { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; color: var(--eco-600); }
  .strat-card h3 { font-size: 1.35rem; margin: 16px 0 12px; color: var(--ink); }
  .strat-card p { color: var(--ink-soft); line-height: 1.75; margin: 0; }
  .strat-line { position: absolute; left: 0; bottom: 0; height: 4px; width: 0; background: linear-gradient(90deg, var(--eco-500), var(--cau-600)); transition: width 0.4s var(--ease); }
  .strat-card:hover .strat-line { width: 100%; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 980px) {
    .strategy-grid { grid-template-columns: repeat(2, 1fr); }
    .tracks-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .mission-grid { grid-template-columns: 1fr; gap: 28px; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 32px 16px; }
    .hero { padding: 120px 0 100px; }
  }
  @media (max-width: 560px) {
    .strategy-grid, .tracks-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Scroll reveal
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }
  }, { threshold: 0.14 });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // Count-up stats
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const countUp = (el: Element) => {
    const target = Number(el.getAttribute('data-count') || '0');
    const dur = 1400; const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min((now - start) / dur, 1);
      el.textContent = String(Math.round(easeOut(p) * target));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  const co = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) { countUp(e.target); co.unobserve(e.target); }
    }
  }, { threshold: 0.6 });
  document.querySelectorAll('.count').forEach((el) => co.observe(el));
</script>
