---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---
<BaseLayout title="페이지를 찾을 수 없습니다">
  <div class="notfound">
    <p class="nf-code">404</p>
    <h1 class="nf-title">페이지를 찾을 수 없습니다</h1>
    <p class="nf-desc">요청하신 페이지가 이동되었거나 존재하지 않습니다.</p>
    <a class="btn btn-primary" href={withBase('/')}>홈으로 돌아가기 →</a>
  </div>
</BaseLayout>
<style>
  .notfound { text-align: center; padding: 80px 0 100px; }
  .nf-code {
    font-family: var(--font-mono); font-weight: 600;
    font-size: clamp(4rem, 16vw, 9rem); line-height: 1; letter-spacing: -0.04em;
    background: linear-gradient(120deg, var(--cau-600), var(--eco-500));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    margin: 0;
  }
  .nf-title { font-size: clamp(1.4rem, 3vw, 2rem); margin: 16px 0 10px; color: var(--ink); }
  .nf-desc { color: var(--muted); margin: 0 0 32px; }
</style>
