---
// src/components/Header.astro
import { SITE, NAV } from '../consts';
import { withBase } from '../lib/url';
const path = Astro.url.pathname;
const isActive = (href: string) => {
  const target = withBase(href);
  return href === '/' ? path === target : path.startsWith(target);
};

// 외부 포털 바로가기 (호버 드롭다운)
const PORTALS = [
  {
    label: '학교포탈',
    links: [
      { label: '중앙대', href: 'https://mportal2.cau.ac.kr' },
      { label: '금오공대', href: 'https://onekit.kumoh.ac.kr' },
    ],
  },
  {
    label: 'e-class',
    links: [
      { label: '중앙대', href: 'https://eclass3.cau.ac.kr' },
      { label: '금오공대', href: 'https://lms.kumoh.ac.kr' },
    ],
  },
];
---
<header class="site-header" data-header>
  <div class="container bar">
    <div class="bar-left">
      <a class="brand" href={withBase('/')} aria-label={SITE.title}>
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="30" height="30">
            <defs>
              <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#37d494" />
                <stop offset="1" stop-color="#1554c0" />
              </linearGradient>
            </defs>
            <circle cx="16" cy="16" r="15" fill="url(#lg)" />
            <path d="M16 7c-5 3-7 6-7 10a7 7 0 0 0 14 0c0-4-2-7-7-10z" fill="#fff" opacity="0.92" />
            <path d="M16 11v10" stroke="#0d3a86" stroke-width="1.4" stroke-linecap="round" />
          </svg>
        </span>
        <span class="brand-text">
          <strong>{SITE.shortTitle}</strong>
          <em>CAU · KIT CONSORTIUM</em>
        </span>
      </a>

      <div class="portals" aria-label="외부 포털 바로가기">
        {PORTALS.map((p) => (
          <div class="portal">
            <button type="button" class="portal-trigger" aria-haspopup="true" aria-expanded="false">
              {p.label}
              <svg class="portal-caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="portal-menu" role="menu">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer" role="menuitem">{l.label}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <input type="checkbox" id="navToggle" class="nav-toggle" hidden />
    <label for="navToggle" class="nav-burger" aria-label="메뉴 열기">
      <span></span><span></span><span></span>
    </label>

    <nav aria-label="주 메뉴" class="site-nav">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={withBase(item.href)} class:list={["nav-link", { active: isActive(item.href) }]} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.3s var(--ease), background 0.3s var(--ease);
  }
  .site-header[data-scrolled] { box-shadow: var(--shadow-md); background: rgba(255, 255, 255, 0.92); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 74px; gap: 24px; }

  .brand { display: inline-flex; align-items: center; gap: 12px; color: var(--ink); }
  .brand-mark { display: inline-flex; filter: drop-shadow(0 3px 8px rgba(21, 84, 192, 0.28)); }
  .brand-text { display: flex; flex-direction: column; line-height: 1.05; }
  .brand-text strong { font-size: 1.02rem; font-weight: 800; letter-spacing: -0.03em; color: var(--ink); }
  .brand-text em {
    font-family: var(--font-mono); font-style: normal; font-size: 0.58rem;
    letter-spacing: 0.18em; color: var(--eco-600); font-weight: 600;
  }
  .brand:hover .brand-text strong { color: var(--cau-700); }

  /* ---------- 외부 포털 드롭다운 ---------- */
  .bar-left { display: flex; align-items: center; gap: 18px; min-width: 0; }
  .portals { display: flex; align-items: center; gap: 4px; padding-left: 18px; border-left: 1px solid var(--line); }
  .portal { position: relative; }
  .portal-trigger {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 7px 12px; border: 0; border-radius: 999px; cursor: pointer;
    background: transparent; color: var(--ink-soft);
    font: inherit; font-weight: 600; font-size: 0.86rem; line-height: 1;
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .portal-caret { transition: transform 0.2s var(--ease); opacity: 0.7; }
  .portal:hover .portal-trigger,
  .portal:focus-within .portal-trigger { color: var(--cau-700); background: var(--surface-2); }
  .portal:hover .portal-caret,
  .portal:focus-within .portal-caret { transform: rotate(180deg); }

  .portal-menu {
    position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%) translateY(-6px);
    min-width: 130px; display: flex; flex-direction: column; gap: 2px; padding: 6px;
    background: var(--surface, #fff); border: 1px solid var(--line); border-radius: 12px;
    box-shadow: var(--shadow-md);
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease), visibility 0.18s var(--ease);
    z-index: 120;
  }
  /* 트리거와 메뉴 사이 간격 위로 마우스가 지나도 유지되도록 브리지 */
  .portal-menu::before { content: ""; position: absolute; top: -10px; left: 0; right: 0; height: 10px; }
  .portal:hover .portal-menu,
  .portal:focus-within .portal-menu {
    opacity: 1; visibility: visible; pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .portal-menu a {
    display: block; padding: 8px 12px; border-radius: 8px;
    color: var(--ink-soft); font-size: 0.88rem; font-weight: 600; white-space: nowrap;
    transition: color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .portal-menu a:hover { color: var(--cau-700); background: var(--surface-2); }

  .site-nav ul { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .nav-link {
    position: relative; display: block; padding: 9px 16px; border-radius: 999px;
    color: var(--ink-soft); font-weight: 600; font-size: 0.94rem;
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .nav-link:hover { color: var(--cau-700); background: var(--surface-2); }
  .nav-link.active { color: var(--cau-700); background: rgba(21, 84, 192, 0.09); }
  .nav-link.active::after {
    content: ""; position: absolute; left: 16px; right: 16px; bottom: 3px; height: 2px;
    background: var(--eco-500); border-radius: 2px;
  }

  .nav-toggle, .nav-burger { display: none; }
  .nav-burger { flex-direction: column; gap: 5px; cursor: pointer; padding: 8px; }
  .nav-burger span { width: 24px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform 0.25s var(--ease), opacity 0.25s var(--ease); }

  @media (max-width: 980px) {
    .portals { display: none; }
  }

  @media (max-width: 820px) {
    .nav-burger { display: flex; }
    .site-nav {
      position: absolute; top: 74px; left: 0; right: 0;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
      max-height: 0; overflow: hidden; transition: max-height 0.3s var(--ease);
    }
    .site-nav ul { flex-direction: column; gap: 2px; padding: 12px 16px 20px; }
    .nav-link { padding: 12px 16px; border-radius: 10px; }
    .nav-link.active::after { display: none; }
    .nav-toggle:checked ~ .site-nav { max-height: 340px; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const onScroll = () => {
    if (window.scrollY > 8) header?.setAttribute('data-scrolled', '');
    else header?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
