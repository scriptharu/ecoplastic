---
// src/components/PostCard.astro
import { withBase } from '../lib/url';
interface Props { href: string; title: string; date: Date; category: string; thumbnail?: string; }
const { href, title, date, category, thumbnail } = Astro.props;
const img = thumbnail ?? '/placeholder.svg';
const dateStr = date.toISOString().slice(0, 10);
---
<a class="card" href={href}>
  <div class="thumb">
    <img src={withBase(img)} alt="" loading="lazy" />
    <span class="cat">{category}</span>
  </div>
  <div class="body">
    <h3>{title}</h3>
    <div class="meta">
      <time datetime={dateStr}>{dateStr}</time>
      <span class="go" aria-hidden="true">→</span>
    </div>
  </div>
</a>
<style>
  .card {
    display: flex; flex-direction: column;
    border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; background: var(--surface); color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: rgba(23, 185, 120, 0.4); }
  .thumb { position: relative; overflow: hidden; aspect-ratio: 16 / 9; background: var(--surface-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease); }
  .card:hover .thumb img { transform: scale(1.06); }
  .cat {
    position: absolute; top: 12px; left: 12px;
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.04em;
    color: #04231a; background: var(--eco-400);
    padding: 4px 10px; border-radius: 999px;
    box-shadow: 0 4px 12px rgba(23, 185, 120, 0.4);
  }
  .body { padding: 20px 20px 22px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  .body h3 {
    font-size: 1.08rem; font-weight: 700; line-height: 1.4; color: var(--ink);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card:hover .body h3 { color: var(--cau-700); }
  .meta { margin-top: auto; display: flex; align-items: center; justify-content: space-between; }
  time { font-family: var(--font-mono); color: var(--muted); font-size: 0.8rem; }
  .go { color: var(--eco-500); font-weight: 700; transition: transform 0.25s var(--ease); }
  .card:hover .go { transform: translateX(4px); }
</style>
