---
// src/components/PageHeader.astro — compact hero band for interior pages
interface Props { eyebrow: string; title: string; description?: string; }
const { eyebrow, title, description } = Astro.props;
---
<section class="page-header">
  <div class="ph-bg" aria-hidden="true"></div>
  <div class="container ph-inner">
    <p class="eyebrow ph-eyebrow">{eyebrow}</p>
    <h1 class="ph-title">{title}</h1>
    {description && <p class="ph-desc">{description}</p>}
  </div>
</section>
<style>
  .page-header { position: relative; overflow: hidden; color: #fff; padding: 116px 0 52px; }
  .ph-bg {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(560px 300px at 88% 0%, var(--eco-glow), transparent 62%),
      linear-gradient(150deg, var(--cau-800), var(--cau-900));
  }
  .ph-bg::after {
    content: ""; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1.4px);
    background-size: 24px 24px;
    -webkit-mask-image: linear-gradient(180deg, #000, transparent 85%);
    mask-image: linear-gradient(180deg, #000, transparent 85%);
  }
  .ph-inner { position: relative; z-index: 1; }
  .ph-eyebrow { color: var(--eco-400); }
  .ph-eyebrow::before { background: var(--eco-400); }
  .ph-title { font-size: clamp(1.9rem, 4vw, 2.9rem); margin-top: 14px; letter-spacing: -0.03em; }
  .ph-desc { margin-top: 14px; max-width: 60ch; color: rgba(255, 255, 255, 0.76); font-size: 1.05rem; }
</style>
