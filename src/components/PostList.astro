---
// src/components/PostList.astro
import PostCard from './PostCard.astro';
import { withBase } from '../lib/url';
import { publishedOnly, sortByDateDesc, paginate } from '../lib/posts';
interface Entry { id: string; data: { title: string; date: Date; category: string; thumbnail?: string; draft: boolean } }
interface Props { base: string; posts: Entry[]; page?: number; perPage?: number; }
const { base, posts, page = 1, perPage = 9 } = Astro.props;
const sorted = sortByDateDesc(publishedOnly(posts));
const { items, page: cur, totalPages } = paginate(sorted, page, perPage);
---
{items.length === 0 ? (
  <div class="empty">
    <span class="empty-mark" aria-hidden="true">🌱</span>
    <p>아직 등록된 글이 없습니다.</p>
  </div>
) : (
  <div class="grid">
    {items.map((post) => (
      <PostCard
        href={withBase(`${base}/${post.id}`)}
        title={post.data.title}
        date={post.data.date}
        category={post.data.category}
        thumbnail={post.data.thumbnail}
      />
    ))}
  </div>
)}
{totalPages > 1 && (
  <nav class="pager" aria-label="페이지">
    {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
      <a class={n === cur ? 'on' : ''} href={withBase(n === 1 ? base : `${base}?page=${n}`)}>{n}</a>
    ))}
  </nav>
)}
<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
  .empty {
    text-align: center; padding: 80px 24px; color: var(--muted);
    border: 1.5px dashed var(--line-strong); border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .empty-mark { font-size: 2.4rem; display: block; margin-bottom: 12px; }
  .pager { display: flex; gap: 8px; justify-content: center; margin-top: 44px; }
  .pager a {
    min-width: 40px; text-align: center; padding: 9px 14px;
    border: 1px solid var(--line); border-radius: 10px;
    font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink-soft);
    background: var(--surface); transition: all 0.2s var(--ease);
  }
  .pager a:hover { border-color: var(--eco-500); color: var(--eco-600); }
  .pager a.on { background: var(--cau-700); color: #fff; border-color: var(--cau-700); }
</style>
